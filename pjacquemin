}

*,*::before,*::after{ box-sizing:border-box; }
html{ -webkit-text-size-adjust:100%; scroll-behavior:smooth; }

body{
margin:0;
background:var(–paper-dim);
color:var(–ink);
font-family:var(–sans);
font-size:16px;
line-height:1.55;
-webkit-font-smoothing:antialiased;
padding-right:var(–rail-w);
}

img{ max-width:100%; display:block; }
ul{ list-style:none; margin:0; padding:0; }
a{ color:inherit; }
h1,h2,h3,p{ margin:0; }

::selection{ background:var(–ink); color:var(–paper); }

:focus-visible{
outline:2px solid var(–safelight);
outline-offset:3px;
}

/* ====== Page column (full-bleed on mobile, framed strip on wider screens) ====== */
.page{
position:relative;
max-width:640px;
margin:0 auto;
background:var(–paper);
box-shadow:0 0 60px rgba(0,0,0,0.05);
overflow:hidden;
}

/* film-grain overlay */
.grain{
position:fixed;
inset:0;
pointer-events:none;
z-index:50;
opacity:0.05;
mix-blend-mode:multiply;
background-image:url(“data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>”);
}

/* ====== Sprocket rail (fixed, viewport edge) ====== */
.rail{
position:fixed;
top:0; right:0;
width:var(–rail-w);
height:100vh;
z-index:40;
border-left:1px solid var(–hairline);
background-color:var(–paper);
background-image:radial-gradient(circle, var(–hairline) 2px, transparent 2.6px);
background-size:100% 28px;
background-position:center 6px;
background-repeat:repeat-y;
}
.rail__fill{
position:absolute;
left:0; right:0; bottom:0;
height:0%;
background:rgba(18,18,16,0.05);
border-top:1px solid var(–hairline);
}
.rail__counter{
position:absolute;
top:14px; left:50%;
transform:translateX(-50%);
writing-mode:vertical-rl;
font-family:var(–mono);
font-size:0.58rem;
letter-spacing:.08em;
color:var(–mist);
white-space:nowrap;
}

/* ====== Eyebrow / mono labels ====== */
.eyebrow{
font-family:var(–mono);
font-size:0.7rem;
letter-spacing:.12em;
text-transform:uppercase;
color:var(–mist);
display:flex;
align-items:center;
gap:.6em;
}
.eyebrow::before{
content:””;
width:5px; height:5px;
border-radius:50%;
background:var(–safelight);
flex:none;
}

.section-title{
font-family:var(–serif);
font-weight:600;
font-size:clamp(1.7rem, 6.4vw, 2.15rem);
line-height:1.18;
margin-top:.6em;
max-width:18ch;
}

/* ====== Sections rhythm ====== */
section, header.intro, footer{
padding:var(–section-y) var(–gutter);
border-top:1px solid var(–hairline);
}
header.intro{ border-top:none; padding-top:clamp(3.5rem,16vw,5.5rem); }

/* ====== HERO ====== */
.hero__eyebrow{ margin-bottom:1.6rem; }
.name{
font-family:var(–serif);
line-height:0.92;
}
.name span{
display:block;
opacity:0;
transform:translateY(.4em);
animation:rise .9s cubic-bezier(.2,.7,.2,1) forwards;
}
.name__first{
font-weight:900;
font-size:clamp(3.1rem, 16.5vw, 4.6rem);
letter-spacing:-0.01em;
animation-delay:.05s;
}
.name__last{
font-weight:300;
font-style:italic;
font-size:clamp(2.7rem, 14.5vw, 4rem);
color:var(–ink);
margin-top:.05em;
animation-delay:.22s;
}
@keyframes rise{ to{ opacity:1; transform:translateY(0); } }

.hero__tagline{
margin-top:1.6rem;
font-family:var(–mono);
font-size:.78rem;
letter-spacing:.1em;
text-transform:uppercase;
color:var(–mist);
opacity:0;
animation:rise .9s cubic-bezier(.2,.7,.2,1) forwards;
animation-delay:.4s;
}

.scrollcue{
margin-top:clamp(3rem,14vw,4.5rem);
display:flex;
align-items:center;
gap:.7rem;
font-family:var(–mono);
font-size:.65rem;
letter-spacing:.14em;
text-transform:uppercase;
color:var(–mist);
opacity:0;
animation:rise .9s cubic-bezier(.2,.7,.2,1) forwards;
animation-delay:.55s;
}
.scrollcue__line{
width:1px; height:34px;
background:var(–hairline);
position:relative;
overflow:hidden;
}
.scrollcue__line::after{
content:””;
position:absolute;
left:0; top:-100%;
width:100%; height:100%;
background:var(–ink);
animation:drip 2.2s ease-in-out infinite;
}
@keyframes drip{
0%{ top:-100%; }
60%{ top:100%; }
100%{ top:100%; }
}

/* ====== Reveal-on-scroll base ====== */
.reveal{
opacity:0;
transform:translateY(22px);
transition:opacity .8s ease, transform .8s ease;
}
.reveal.is-visible{ opacity:1; transform:translateY(0); }

/* “developing” photo reveal */
.develop img{
filter:grayscale(1) contrast(.45) brightness(1.65) blur(7px);
opacity:.75;
transform:scale(1.04);
transition:filter 1.4s cubic-bezier(.2,.7,.2,1), transform 1.4s cubic-bezier(.2,.7,.2,1), opacity 1s ease;
}
.develop.is-visible img{
filter:grayscale(0) contrast(1) brightness(1) blur(0);
opacity:1;
transform:scale(1);
}
.develop.bw.is-visible img{ filter:grayscale(1) contrast(1) brightness(1) blur(0); }

