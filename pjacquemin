<script>
  // Scroll-driven reveals ("développement" + fade-up)
  const targets = document.querySelectorAll('.reveal, .develop');
  if ('IntersectionObserver' in window){
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold:0.18, rootMargin:'0px 0px -8% 0px' });
    targets.forEach(t=>io.observe(t));
  } else {
    targets.forEach(t=>t.classList.add('is-visible'));
  }

  // Sprocket rail: scroll progress mapped to a 36-exposure roll
  const railFill = document.getElementById('railFill');
  const railCounter = document.getElementById('railCounter');
  const TOTAL_FRAMES = 36;
  let ticking = false;

  function updateRail(){
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const pct = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
    railFill.style.height = (pct * 100) + '%';
    const frame = Math.max(1, Math.min(TOTAL_FRAMES, Math.round(pct * TOTAL_FRAMES) || 1));
    railCounter.textContent = String(frame).padStart(2,'0') + ' / ' + TOTAL_FRAMES;
    ticking = false;
  }

  window.addEventListener('scroll', ()=>{
    if(!ticking){ requestAnimationFrame(updateRail); ticking = true; }
  }, { passive:true });
  window.addEventListener('resize', updateRail);
  updateRail();
</script>

